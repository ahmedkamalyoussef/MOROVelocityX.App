<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MOROVelocityX.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
        x:Class="MOROVelocityX.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="MOROVelocityX"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#00BFFF"/>
            <Setter Property="BorderBrush" Value="#00FFFF"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="Foreground" Value="#00FFFF"/>
            <Setter Property="BorderBrush" Value="#00BFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#00BFFF"/>
            <Setter Property="Foreground" Value="#0A0A1A"/>
            <Setter Property="BorderBrush" Value="#00FFFF"/>
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="#00FFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style Selector="RadioButton:pointerover">
            <Setter Property="Foreground" Value="#00BFFF"/>
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="Foreground" Value="#00FFFF"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Effect">
                <DropShadowEffect Color="#00BFFF" BlurRadius="15" OffsetX="0" OffsetY="0"/>
            </Setter>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#00FFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Border.glass-panel">
            <Setter Property="Background" Value="#1A1A2E90"/>
            <Setter Property="BorderBrush" Value="#00BFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="BoxShadow" Value="0 0 30 #00BFFF40"/>
        </Style>
        <Style Selector="Border.section">
            <Setter Property="Background" Value="#0A0A1A70"/>
            <Setter Property="BorderBrush" Value="#00BFFF60"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
        <Style Selector="Slider">
            <Setter Property="Foreground" Value="#00FFFF"/>
            <Setter Property="Background" Value="#1A1A2E"/>
        </Style>
    </Window.Styles>

    <Panel>
        <Border>
            <Border.Background>
                <ImageBrush Source="/Assets/Images/background.jpg" Stretch="UniformToFill"/>
            </Border.Background>
        </Border>

        <Grid RowDefinitions="Auto,*,Auto">
            <Border Grid.Row="0" 
                    Background="#0A0A1A80" 
                    Padding="20,15"
                    CornerRadius="0,0,0,20"
                    BoxShadow="0 5 20 #00BFFF30">
                <TextBlock Text="MORO VELOCITY X" 
                           Classes="title"
                           HorizontalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Row="1" 
                       Orientation="Vertical" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"
                       Spacing="20">
                <Border Classes="glass-panel" 
                        Padding="30"
                        Width="700"
                        MaxWidth="700">
                    <StackPanel Spacing="25">
                        <TextBlock Text="CONTROL PANEL" 
                                   Classes="label"
                                   HorizontalAlignment="Center"
                                   FontSize="18"
                                   Margin="0,0,0,10"/>

                        <Grid ColumnDefinitions="*,*">
                            <Border Grid.Column="0" Classes="section">
                                <StackPanel Spacing="15">
                                    <TextBlock Text="TRIGGER KEY" 
                                               Classes="label"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,10"/>
                                    <Button Content="Capture" 
                                            Command="{Binding CaptureTriggerKeyCommand}"
                                            HorizontalAlignment="Stretch"/>
                                    <TextBlock Text="{Binding TriggerKey}" 
                                               Classes="value"
                                               HorizontalAlignment="Center"
                                               FontSize="18"
                                               Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Classes="section">
                                <StackPanel Spacing="15">
                                    <TextBlock Text="CLICK KEY" 
                                               Classes="label"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,10"/>
                                    <Button Content="Capture" 
                                            Command="{Binding CaptureClickKeyCommand}"
                                            HorizontalAlignment="Stretch"/>
                                    <TextBlock Text="{Binding ClickKey}" 
                                               Classes="value"
                                               HorizontalAlignment="Center"
                                               FontSize="18"
                                               Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Classes="section">
                            <StackPanel Spacing="15">
                                <TextBlock Text="MODE" 
                                           Classes="label"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" Spacing="30" HorizontalAlignment="Center">
                                    <RadioButton Content="Toggle Mode" 
                                                IsChecked="{Binding IsToggleMode}"
                                                GroupName="Mode"/>
                                    <RadioButton Content="Hold Mode" 
                                                IsChecked="{Binding IsHoldMode}"
                                                GroupName="Mode"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="section">
                            <StackPanel Spacing="15">
                                <TextBlock Text="CPS" 
                                           Classes="label"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                                    <TextBlock Text="Value:" Classes="label"/>
                                    <TextBlock Text="{Binding CPS}" Classes="value" FontSize="18"/>
                                </StackPanel>
                                <Slider Minimum="1" 
                                        Maximum="1000" 
                                        Value="{Binding CPS}"
                                        TickFrequency="10"
                                        IsSnapToTickEnabled="True"
                                        Margin="0,15,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="section">
                            <StackPanel Spacing="15">
                                <TextBlock Text="STATUS" 
                                           Classes="label"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding StatusText}" 
                                           Classes="value"
                                           HorizontalAlignment="Center"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Margin="0,10,0,0">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#00BFFF" BlurRadius="10" OffsetX="0" OffsetY="0"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" 
                                   HorizontalAlignment="Center" 
                                   Spacing="20"
                                   Margin="0,10,0,0">
                            <Button Content="START" 
                                    Command="{Binding StartCommand}"
                                    Width="150"
                                    Height="50"
                                    FontSize="16"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="#00BFFF"
                                    Foreground="#0A0A1A">
                                <Button.Effect>
                                    <DropShadowEffect Color="#00BFFF" BlurRadius="15" OffsetX="0" OffsetY="0"/>
                                </Button.Effect>
                            </Button>
                            <Button Content="STOP" 
                                    Command="{Binding StopCommand}"
                                    Width="150"
                                    Height="50"
                                    FontSize="16"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="#FF4444"
                                    Foreground="#FFFFFF"
                                    BorderBrush="#FF6666">
                                <Button.Effect>
                                    <DropShadowEffect Color="#FF4444" BlurRadius="15" OffsetX="0" OffsetY="0"/>
                                </Button.Effect>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Panel>
</Window>
