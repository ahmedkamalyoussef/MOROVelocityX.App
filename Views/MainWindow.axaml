<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MOROVelocityX.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
        x:Class="MOROVelocityX.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/app-icon.ico"
        Title="MOROVelocityX"
        MinWidth="400"
        MinHeight="400"
        Background="#0A0A1A"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing">

    <Window.Styles>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#00BFFF"/>
            <Setter Property="BorderBrush" Value="#00FFFF"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="Foreground" Value="#00FFFF"/>
            <Setter Property="BorderBrush" Value="#00BFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#00BFFF"/>
            <Setter Property="Foreground" Value="#0A0A1A"/>
            <Setter Property="BorderBrush" Value="#00FFFF"/>
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="#00FFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style Selector="RadioButton:pointerover">
            <Setter Property="Foreground" Value="#00BFFF"/>
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="Foreground" Value="#00FFFF"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#00FFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Border.glass-panel">
            <Setter Property="Background" Value="#1A1A2EC0"/>
            <Setter Property="BorderBrush" Value="#00BFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BoxShadow" Value="0 0 16 #00BFFF30"/>
        </Style>
        <Style Selector="Border.section">
            <Setter Property="Background" Value="#0A0A1A90"/>
            <Setter Property="BorderBrush" Value="#00BFFF60"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style Selector="Slider">
            <Setter Property="Foreground" Value="#00FFFF"/>
            <Setter Property="Background" Value="#1A1A2E"/>
        </Style>
        <Style Selector="ScrollViewer /template/ ScrollBar">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </Window.Styles>

    <Panel>
        <Image Source="/Assets/Images/background.jpg"
               Stretch="UniformToFill">
            <Image.Effect>
                <BlurEffect Radius="6"/>
            </Image.Effect>
        </Image>

        <Border Background="#0A0A1A70"/>

        <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    Background="#0A0A1A90"
                    Padding="16,10"
                    CornerRadius="0,0,0,16"
                    BoxShadow="0 4 16 #00BFFF30">
                <TextBlock Text="MORO VELOCITY X"
                           Classes="title"
                           HorizontalAlignment="Center"/>
            </Border>

            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                <Border Classes="glass-panel"
                        Padding="16"
                        MinWidth="320"
                        MaxWidth="780"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="12">
                    <StackPanel Spacing="10">
                        <TextBlock Text="CONTROL PANEL"
                                   Classes="label"
                                   HorizontalAlignment="Center"
                                   FontSize="16"
                                   Margin="0,0,0,6"/>

                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto">
                            <Border Grid.Row="0" Grid.Column="0" Classes="section" Margin="0,0,4,0">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="TRIGGER KEY"
                                               Classes="label"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,6"/>
                                    <Button Content="Capture"
                                            Command="{Binding CaptureTriggerKeyCommand}"
                                            HorizontalAlignment="Stretch"/>
                                    <TextBlock Text="{Binding TriggerKey}"
                                               Classes="value"
                                               HorizontalAlignment="Center"
                                               FontSize="16"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Classes="section" Margin="4,0,0,0">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="CLICK KEY"
                                               Classes="label"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,6"/>
                                    <Button Content="Capture"
                                            Command="{Binding CaptureClickKeyCommand}"
                                            HorizontalAlignment="Stretch"/>
                                    <TextBlock Text="{Binding ClickKey}"
                                               Classes="value"
                                               HorizontalAlignment="Center"
                                               FontSize="16"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Classes="section">
                            <StackPanel Spacing="10">
                                <TextBlock Text="MODE"
                                           Classes="label"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                                    <RadioButton Content="Toggle Mode"
                                                IsChecked="{Binding IsToggleMode}"
                                                GroupName="Mode"/>
                                    <RadioButton Content="Hold Mode"
                                                IsChecked="{Binding IsHoldMode}"
                                                GroupName="Mode"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="section">
                            <StackPanel Spacing="10">
                                <TextBlock Text="CPS"
                                           Classes="label"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                    <TextBlock Text="Value:" Classes="label"/>
                                    <TextBlock Text="{Binding CPS}" Classes="value" FontSize="16"/>
                                </StackPanel>
                                <Slider Minimum="1"
                                        Maximum="500"
                                        Value="{Binding CPS}"
                                        TickFrequency="10"
                                        IsSnapToTickEnabled="True"
                                        Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="section">
                            <StackPanel Spacing="10">
                                <TextBlock Text="LICENSE"
                                           Classes="label"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,6"/>
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Status:" Classes="label" Margin="0,0,8,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LicenseStatusText}" Classes="value"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Type:" Classes="label" Margin="0,0,8,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LicenseTypeText}" Classes="value"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Expires:" Classes="label" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LicenseExpiryText}" Classes="value"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="section">
                            <StackPanel Spacing="10">
                                <TextBlock Text="STATUS"
                                           Classes="label"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding StatusText}"
                                           Classes="value"
                                           HorizontalAlignment="Center"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="12"
                                    Margin="0,6,0,0">
                            <Button Content="START"
                                    Command="{Binding StartCommand}"
                                    MinWidth="100"
                                    Height="44"
                                    FontSize="15"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="#00BFFF"
                                    Foreground="#0A0A1A"/>
                            <Button Content="STOP"
                                    Command="{Binding StopCommand}"
                                    MinWidth="100"
                                    Height="44"
                                    FontSize="15"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="#FF4444"
                                    Foreground="#FFFFFF"
                                    BorderBrush="#FF6666"/>
                        </StackPanel>
                        <TextBlock Text="F2: Toggle Overlay  |  F3: Edit Mode"
                                   FontSize="9"
                                   Foreground="#00FFFF"
                                   Opacity="0.4"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>
                        <TextBlock Name="TelegramLink"
                                   FontSize="10"
                                   Foreground="#00FFFF"
                                   Opacity="0.35"
                                   HorizontalAlignment="Center"
                                   Cursor="Hand"
                                   Margin="0,2,0,4">
                            <Run Text="Contact "/>
                            <Run Foreground="#66DDFF" Text="@Unro0"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Panel>
</Window>
